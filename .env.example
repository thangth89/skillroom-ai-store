# URL website sau khi deploy
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Thanh toán quốc tế mặc định tắt cho tới khi có nhà cung cấp được duyệt.
INTERNATIONAL_CHECKOUT_ENABLED=false
INTERNATIONAL_PAYMENT_PROVIDER=

# Chỉ giữ để tương thích dữ liệu/webhook Lemon cũ; không cần cho website mới.
