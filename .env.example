NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SKILL_STORAGE_BUCKET=skills-private
ADMIN_EMAILS=admin@example.com

# payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Skillroom <orders@your-domain.com>
EMAIL_REPLY_TO=support@example.com
