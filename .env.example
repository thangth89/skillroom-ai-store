# URL website sau khi deploy
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# PayPal quốc tế (sandbox để thử; đổi cả credential và môi trường sang live khi vận hành thật)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Thêm sau khi tạo webhook trong PayPal Developer Dashboard.
PAYPAL_WEBHOOK_ID=

# Chỉ giữ để tương thích dữ liệu/webhook Lemon cũ; không cần cho website mới.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SKILL_STORAGE_BUCKET=skills-private
ADMIN_EMAILS=admin@example.com

# payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=Skillroom <orders@your-domain.com>
EMAIL_REPLY_TO=support@example.com
